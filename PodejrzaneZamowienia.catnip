          "interactiveReport": "{\u0022ClassName\u0022:\u0022PodejrzaneZamowienia\u0022,\u0022Title\u0022:\u0022Kt\\u00F3re zam\\u00F3wienia s\\u0105 podejrzane?\u0022,\u0022Inputs\u0022:[\u0022findings\u0022,\u0022narrator\u0022,\u0022formatter\u0022],\u0022Height\u0022:1900,\u0022KeepAlive\u0022:true,\u0022Markup\u0022:\u0022\\u003Cdiv class=\\u0022cn-page\\u0022\\u003E\\n  \\u003Ch1\\u003EKt\\u00F3re zam\\u00F3wienia s\\u0105 podejrzane?\\u003C/h1\\u003E\\n  \\u003Cp class=\\u0022cn-muted\\u0022\\u003E{source_note} \\u00B7 zam\\u00F3wienia (CSV) \\u002B klienci (JSON) \\u002B produkty (Excel) \\u2192 Data Scan \\u2192 regu\\u0142y \\u002B wzorce klient\\u00F3w \\u2192 lista do sprawdzenia\\u003C/p\\u003E\\n\\n  \\u003Cdiv class=\\u0022cn-grid-4\\u0022\\u003E\\n    {self._kpi(\\u0022Przejrzane zam\\u00F3wienia\\u0022, f.num(r.total_orders), \\u0022w \\u0022 \\u002B f.num(r.seconds, 1) \\u002B \\u0022 s\\u0022)}\\n    {self._kpi(\\u0022Do sprawdzenia\\u0022, str(r.flagged_count), f.pct(100 * r.flagged_count / r.total_orders, 4) \\u002B \\u0022 wszystkich\\u0022, -r.flagged_count)}\\n    {self._kpi(\\u0022Klienci do sprawdzenia\\u0022, str(r.customer_count), \\u0022klony i nag\\u0142e zmiany\\u0022, -r.customer_count)}\\n    {self._kpi(\\u0022Strata na cenach poni\\u017Cej kosztu\\u0022, f.zl(loss), \\u0022warto\\u015B\\u0107 podejrzanych: \\u0022 \\u002B f.short_zl(r.flagged_value), -loss)}\\n  \\u003C/div\\u003E\\n\\n  \\u003Cdiv class=\\u0022cn-grid-2\\u0022\\u003E\\n    \\u003Cdiv class=\\u0022cn-card answer\\u0022\\u003E\\n      \\u003Ch3\\u003EOdpowied\\u017A\\u003C/h3\\u003E\\n      \\u003Cp class=\\u0022headline\\u0022\\u003E{headline}\\u003C/p\\u003E\\n      {findings_html}\\n      {button(\\u0022Zapisz list\\u0119 do CSV\\u0022, action=\\u0022eksport\\u0022)}\\n      {button(\\u0022Eksportuj do Power BI\\u0022, action=\\u0022powerbi\\u0022)}\\n    \\u003C/div\\u003E\\n    \\u003Cdiv class=\\u0022cn-card\\u0022\\u003E\\n      \\u003Ch3\\u003ETrafienia regu\\u0142\\u003C/h3\\u003E\\n      {rule_chart}\\n    \\u003C/div\\u003E\\n  \\u003C/div\\u003E\\n\\n  \\u003Cdiv class=\\u0022cn-card\\u0022\\u003E\\n    \\u003Ch3\\u003EZam\\u00F3wienia do sprawdzenia\\u003C/h3\\u003E\\n    \\u003Cdiv class=\\u0022cn-row\\u0022\\u003E{select(\\u0022rule\\u0022, rule_options, label=\\u0022Poka\\u017C\\u0022)}\\u003C/div\\u003E\\n    \\u003Cdiv class=\\u0022cn-grid-2 wide-left\\u0022\\u003E\\n      \\u003Cdiv\\u003E{table(flagged_rows, page_size=12, select=\\u0022chosen\\u0022, id=\\u0022flagged\\u0022)}\\u003C/div\\u003E\\n      \\u003Cdiv class=\\u0022cn-card\\u0022\\u003E{chosen_html}\\u003C/div\\u003E\\n    \\u003C/div\\u003E\\n  \\u003C/div\\u003E\\n\\n  \\u003Cdiv class=\\u0022cn-grid-2\\u0022\\u003E\\n    \\u003Cdiv class=\\u0022cn-card\\u0022\\u003E\\u003Ch3\\u003EKto stoi za podejrzanymi cenami i rabatami?\\u003C/h3\\u003E{rep_chart}\\u003C/div\\u003E\\n    \\u003Cdiv class=\\u0022cn-card\\u0022\\u003E\\n      \\u003Ch3\\u003EKlienci o identycznym wzorcu zakup\\u00F3w\\u003C/h3\\u003E\\n      {table(r.similar_rows, filter=False, id=\\u0022clones\\u0022)}\\n      \\u003Ch3\\u003ENag\\u0142a zmiana zachowania\\u003C/h3\\u003E\\n      {table(r.behaviour_rows, filter=False, id=\\u0022behaviour\\u0022)}\\n    \\u003C/div\\u003E\\n  \\u003C/div\\u003E\\n\\n  \\u003Cdiv class=\\u0022cn-card\\u0022\\u003E\\n    \\u003Ch3\\u003EData Scan \\u2014 co CatNip rozpozna\\u0142 w danych\\u003C/h3\\u003E\\n    \\u003Cdiv class=\\u0022cn-grid-2\\u0022\\u003E\\n      \\u003Cpre class=\\u0022scan\\u0022\\u003E{scan_tree}\\u003C/pre\\u003E\\n      \\u003Cdiv\\u003E\\n        \\u003Cp\\u003E\\u003Cb\\u003EPowi\\u0105zania wykryte automatycznie\\u003C/b\\u003E\\u003C/p\\u003E\\n        {relations_html}\\n        \\u003Cp\\u003E\\u003Cb\\u003EPipeline\\u003C/b\\u003E\\u003C/p\\u003E\\n        {table(pipeline_rows, filter=False, sortable=False, page_size=15, id=\\u0022pipeline\\u0022)}\\n      \\u003C/div\\u003E\\n    \\u003C/div\\u003E\\n  \\u003C/div\\u003E\\n\\u003C/div\\u003E\\n\u0022,\u0022Code\u0022:\u0022def setup(self):\\n    self.set(\\u0022rule\\u0022, \\u0022Wszystkie regu\\u0142y\\u0022)\\n\\ndef prepare(self):\\n    r = self.findings\\n    f = self.formatter\\n    rule = self.get(\\u0022rule\\u0022) or \\u0022Wszystkie regu\\u0142y\\u0022\\n    flagged = r.flagged if rule == \\u0022Wszystkie regu\\u0142y\\u0022 else r.flagged[r.flagged[\\u0022Powody\\u0022].str.contains(rule, regex=False)]\\n    chosen = self.get(\\u0022chosen\\u0022)\\n    return {\\n        \\u0022r\\u0022: r,\\n        \\u0022f\\u0022: f,\\n        \\u0022headline\\u0022: self.narrator.headline(r),\\n        \\u0022findings_html\\u0022: html(\\u0022\\u003Cul\\u003E%s\\u003C/ul\\u003E\\u0022 % \\u0022\\u0022.join(\\u0022\\u003Cli\\u003E%s\\u003C/li\\u003E\\u0022 % esc(line) for line in self.narrator.findings(r))),\\n        \\u0022rule_options\\u0022: [\\u0022Wszystkie regu\\u0142y\\u0022] \\u002B [row[\\u0022Regu\\u0142a\\u0022] for row in r.rule_rows],\\n        \\u0022flagged_rows\\u0022: flagged,\\n        \\u0022rule_chart\\u0022: self._rule_chart(r),\\n        \\u0022rep_chart\\u0022: self._rep_chart(r),\\n        \\u0022chosen_html\\u0022: self._chosen_html(chosen),\\n        \\u0022loss\\u0022: float(r.flagged[\\u0022Strata\\u0022].sum()),\\n        \\u0022scan_tree\\u0022: r.scan.tree_text(),\\n        \\u0022relations_html\\u0022: html(\\u0022\\u003Cul\\u003E%s\\u003C/ul\\u003E\\u0022 % \\u0022\\u0022.join(\\u0022\\u003Cli\\u003E%s\\u003C/li\\u003E\\u0022 % esc(x) for x in r.scan.relations())),\\n        \\u0022pipeline_rows\\u0022: r.scan.pipeline_rows(),\\n        \\u0022source_note\\u0022: \\u0022dane demonstracyjne wygenerowane przed chwil\\u0105 w input/\\u0022 if r.demo else \\u0022dane z folderu input/\\u0022,\\n    }\\n\\ndef _rule_chart(self, r):\\n    rows = sorted(r.rule_rows, key=lambda row: row[\\u0022Zam\\u00F3wienia\\u0022])\\n    return chart(\\u0022barh\\u0022, rows, x=\\u0022Regu\\u0142a\\u0022, y=\\u0022Zam\\u00F3wienia\\u0022, height=300, colors=[\\u0022#d9534f\\u0022], text=\\u0022Zam\\u00F3wienia\\u0022,\\n                 layout={\\u0022margin\\u0022: {\\u0022l\\u0022: 170, \\u0022r\\u0022: 20, \\u0022t\\u0022: 20, \\u0022b\\u0022: 40}})\\n\\ndef _rep_chart(self, r):\\n    rows = r.rep_rows[:8]\\n    if not rows:\\n        return html(\\u0022\\u003Cp class=\\u0027cn-muted\\u0027\\u003EBrak podejrzanych cen i rabat\\u00F3w.\\u003C/p\\u003E\\u0022)\\n    return chart(\\u0022bar\\u0022, rows, x=\\u0022Handlowiec\\u0022, y=[\\u0022Udzia\\u0142 w podejrzanych %\\u0022, \\u0022Udzia\\u0142 we wszystkich zam\\u00F3wieniach %\\u0022],\\n                 height=300, colors=[\\u0022#d9534f\\u0022, \\u0022#9aa5b1\\u0022], y_title=\\u0022%\\u0022)\\n\\ndef _chosen_html(self, chosen):\\n    if not chosen:\\n        return html(\\u0022\\u003Cp class=\\u0027cn-muted\\u0027\\u003EKliknij wiersz tabeli, \\u017Ceby zobaczy\\u0107 szczeg\\u00F3\\u0142y zam\\u00F3wienia.\\u003C/p\\u003E\\u0022)\\n    reasons = \\u0022\\u0022.join(\\u0022\\u003Cspan class=\\u0027flag\\u0027\\u003E%s\\u003C/span\\u003E\\u0022 % esc(x.strip()) for x in str(chosen.get(\\u0022Powody\\u0022, \\u0022\\u0022)).split(\\u0022,\\u0022))\\n    fields = \\u0022\\u0022.join(\\u0022\\u003Ctr\\u003E\\u003Ctd\\u003E%s\\u003C/td\\u003E\\u003Ctd\\u003E\\u003Cb\\u003E%s\\u003C/b\\u003E\\u003C/td\\u003E\\u003C/tr\\u003E\\u0022 % (esc(k), esc(v)) for k, v in chosen.items() if k != \\u0022Powody\\u0022)\\n    return html(\\u0022\\u003Cp\\u003E%s\\u003C/p\\u003E\\u003Ctable class=\\u0027detail\\u0027\\u003E%s\\u003C/table\\u003E\\u0022 % (reasons, fields))\\n\\ndef on_eksport(self, values):\\n    self.toast(\\u0022Zapisuj\\u0119 %d zam\\u00F3wie\\u0144 do output/\\u2026\\u0022 % self.findings.flagged_count, \\u0022info\\u0022)\\n    return self.findings\\n\\ndef on_powerbi(self, values):\\n    self.toast(\\u0022Eksportuj\\u0119 %d zam\\u00F3wie\\u0144 do Power BI (output/powerbi/)\\u2026\\u0022 % self.findings.flagged_count, \\u0022info\\u0022)\\n    return self.findings\\n\\ndef _kpi(self, label, value, delta=None, change=0.0, good_up=True):\\n    \\u0022\\u0022\\u0022Kafelek KPI: strza\\u0142ka i kolor bior\\u0105 si\\u0119 z liczby change, a opis zmiany (delta) jest ju\\u017C po polsku.\\u0022\\u0022\\u0022\\n    extra = \\u0022\\u0022\\n    if delta is not None:\\n        tone = \\u0022cn-good\\u0022 if (change \\u003E= 0) == good_up else \\u0022cn-bad\\u0022\\n        arrow = \\u0022\\u25B2\\u0022 if change \\u003E 0 else (\\u0022\\u25BC\\u0022 if change \\u003C 0 else \\u0022\\u2022\\u0022)\\n        extra = \\u0027\\u003Cdiv class=\\u0022cn-kpi-delta %s\\u0022\\u003E%s %s\\u003C/div\\u003E\\u0027 % (tone, arrow, esc(delta))\\n    return html(\\u0027\\u003Cdiv class=\\u0022cn-kpi\\u0022\\u003E\\u003Cdiv class=\\u0022cn-kpi-label\\u0022\\u003E%s\\u003C/div\\u003E\\u003Cdiv class=\\u0022cn-kpi-value\\u0022\\u003E%s\\u003C/div\\u003E%s\\u003C/div\\u003E\\u0027\\n                % (esc(label), esc(value), extra))\\n\u0022,\u0022Style\u0022:\u0022.cn-page h1 { margin-bottom: 2px; }\\n.cn-card h3 { margin-top: 0; }\\n.answer .headline { font-size: 1.15em; font-weight: 600; }\\n.answer ol, .answer ul { margin-top: 4px; padding-left: 22px; }\\n.answer li { margin: 3px 0; }\\npre.scan { font-size: 0.82em; line-height: 1.35; max-height: 420px; overflow: auto; background: rgba(127,127,127,0.08); padding: 10px; border-radius: 6px; }\\n.cn-kpi-value { font-size: 1.35em; }\\n.flag { display: inline-block; padding: 1px 6px; margin: 1px; border-radius: 4px; font-size: 0.85em; background: rgba(220,57,18,0.12); }\\n.wide-left { grid-template-columns: 2fr 1fr; }\\ntable.detail td { padding: 2px 8px 2px 0; vertical-align: top; }\\n\u0022,\u0022SampleData\u0022:\u0022\u0022,\u0022Actions\u0022:[{\u0022Name\u0022:\u0022eksport\u0022,\u0022Label\u0022:\u0022Zapisz list\\u0119 do CSV\u0022,\u0022Mode\u0022:\u0022Live\u0022,\u0022Description\u0022:\u0022Zapisuje list\\u0119 podejrzanych zam\\u00F3wie\\u0144 do output/ jako CSV dla Excela.\u0022},{\u0022Name\u0022:\u0022powerbi\u0022,\u0022Label\u0022:\u0022Eksportuj do Power BI\u0022,\u0022Mode\u0022:\u0022Live\u0022,\u0022Description\u0022:\u0022Zapisuje list\\u0119 podejrzanych zam\\u00F3wie\\u0144 jako Parquet dla Power BI (output/powerbi/podejrzane_zamowienia.parquet).\u0022}]}",
